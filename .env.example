# Reference for the settings the tests read. config.py reads environment variables only (it does not
# load a .env file), so set these in your shell if you want to override the defaults.

# Site under test
HEFESTO_URL=https://thjsantos.github.io/hefesto-studio/

# Appium server
APPIUM_URL=http://127.0.0.1:4723

# Leave empty to use the only connected phone. Otherwise the serial from `adb devices`.
ANDROID_UDID=
